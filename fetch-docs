#!/bin/bash
# --mcp のレビューでモデルが引く資料(Python・Django・HTML)を取得する。窓口サーバで実行する。
# 計算ノードのジョブはネットワークを使わないので、ここで /work/$USER/llm/docs に用意しておく。
#
#   fetch-docs                          # Python 3.14、Django 6.1.2、HTML(MDN)
#   fetch-docs --python 3.13 --django 5.2.8
#
# 取得したものは mcp_docs_server.py が検索する。版を変えて取り直すと、古い版の隣に置かれる
# (使う版は review-pr --docs-python / --docs-django で選ぶ。既定は取得済みの最も新しい版)。
set -euo pipefail

PY_VER=3.14 DJ_VER=6.1.2
while (( $# )); do
  case $1 in
    --python) PY_VER=${2:?}; shift 2 ;;
    --django) DJ_VER=${2:?}; shift 2 ;;
    -h|--help) sed -n 2,9p "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "fetch-docs: unknown argument: $1" >&2; exit 1 ;;
  esac
done

DOCS=${LLM_HOME:-/work/$USER/llm}/docs
mkdir -p "$DOCS"
TMP=$(mktemp -d "$DOCS/.tmp.XXXXXX")
trap 'rm -rf "$TMP"' EXIT

# Python: 公式のテキスト版(reST を整形したもの)
if [ ! -d "$DOCS/python-$PY_VER" ]; then
  echo "Python $PY_VER docs"
  curl -fL --progress-bar -o "$TMP/py.tar.bz2" \
    "https://docs.python.org/$PY_VER/archives/python-$PY_VER-docs-text.tar.bz2"
  mkdir "$TMP/py" && tar -xjf "$TMP/py.tar.bz2" -C "$TMP/py" --strip-components=1
  mv "$TMP/py" "$DOCS/python-$PY_VER"
fi

# Django: 配布物(sdist)に含まれる docs/(reST)
if [ ! -d "$DOCS/django-$DJ_VER" ]; then
  echo "Django $DJ_VER docs"
  url=$(curl -sf "https://pypi.org/pypi/django/$DJ_VER/json" | python3 -c 'import json,sys
print(next(u["url"] for u in json.load(sys.stdin)["urls"] if u["packagetype"] == "sdist"))') \
    || { echo "fetch-docs: Django $DJ_VER not found on PyPI" >&2; exit 1; }
  curl -fL --progress-bar -o "$TMP/dj.tar.gz" "$url"
  mkdir "$TMP/dj" && tar -xzf "$TMP/dj.tar.gz" -C "$TMP/dj" --strip-components=2 --wildcards '*/docs/*'
  mv "$TMP/dj" "$DOCS/django-$DJ_VER"
fi

# HTML: MDN の HTML の項目(要素・属性・ガイド)。リポジトリ全体は大きいので、その部分だけ取る
if [ ! -d "$DOCS/mdn-html" ]; then
  echo "HTML docs (MDN)"
  git clone -q --depth 1 --filter=blob:none --sparse https://github.com/mdn/content "$TMP/mdn"
  git -C "$TMP/mdn" sparse-checkout set files/en-us/web/html
  mv "$TMP/mdn/files/en-us/web/html" "$DOCS/mdn-html"
fi

du -sh "$DOCS"/*/ | sed "s|$DOCS/||"

#!/bin/bash
#PBS -q Eduq
#PBS -N llmprobeamd
#PBS -l select=1:ncpus=1:mem=4gb:ngpus=2
#PBS -l walltime=00:10:00
#PBS -j oe
#PBS -v SINGULARITY_IMAGE=/common/Singularity_sif/prg_env_amd_2025.02.sif
# Eduq(AMD MI210)用の疎通確認。GPU、ROCm、ネットワーク、コンテナ内の道具を確かめる。
hostname
rocm-smi --showproductname --showmeminfo vram 2>&1 | grep -E 'GPU\[|Card|VRAM Total' | head -8
rocminfo 2>/dev/null | grep -m2 -E 'gfx[0-9a-f]+'
echo "HIP_VISIBLE_DEVICES=${HIP_VISIBLE_DEVICES:-} ROCR_VISIBLE_DEVICES=${ROCR_VISIBLE_DEVICES:-} CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-}"
ls /opt/rocm*/ -d 2>/dev/null; cat /opt/rocm/.info/version 2>/dev/null
echo "--- net"; curl -sI -m 10 https://github.com | head -1; curl -sI -m 10 https://registry.ollama.ai/v2/ | head -1
echo "--- tools"; which python3 curl zstd sha256sum; python3 --version

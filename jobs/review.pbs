#!/bin/bash
#PBS -q iEduq
#PBS -N llmreview
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -v SINGULARITY_IMAGE=/common/Singularity_sif/prg_env_intel_2025.02.sif
# 単発レビュー。submit_review.sh から RUN_DIR, MODEL, ROOT を受け取る。
set -euo pipefail
ulimit -c 0

OLLAMA_LOG=$RUN_DIR/ollama.log
. "$ROOT/jobs/ollama_env.sh"

python3 "$ROOT/review.py" --host "$OLLAMA_URL" --model "$MODEL" \
  --pr-json "$RUN_DIR/pr.json" --diff "$RUN_DIR/pr.diff" --out "$RUN_DIR/review.md"
echo "done: $RUN_DIR/review.md"

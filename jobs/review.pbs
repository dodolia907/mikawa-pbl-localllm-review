#!/bin/bash
#PBS -q iEduq
#PBS -N llmreview
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -v SINGULARITY_IMAGE=/common/Singularity_sif/prg_env_intel_2025.02.sif
# PR を 1 件レビューする。review-pr から RUN_DIR, MODEL, ROOT を受け取る(キュー等も review-pr が指定する)。
set -euo pipefail
ulimit -c 0

# PBS の -o はジョブ終了時にしか書き出されないので、review-pr が進み具合を表示できるよう別にも書く
exec > >(tee -a "$RUN_DIR/progress") 2>&1

OLLAMA_LOG=$RUN_DIR/ollama.log
. "$ROOT/jobs/ollama_env.sh"

. "$ROOT/jobs/run_review.sh"
echo "Reviewing"
# 生成途中の出力を stream.txt に書き足していく(review-pr がこれを画面に流す)
run_review "$OLLAMA_URL" "$MODEL" "$RUN_DIR"

#!/bin/bash
#PBS -q iEduq
#PBS -N llmprobe
#PBS -l select=1:ncpus=1:mem=4gb:ngpus=1
#PBS -l walltime=00:10:00
#PBS -j oe
#PBS -v SINGULARITY_IMAGE=/common/Singularity_sif/prg_env_intel_2025.02.sif
hostname; nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv
echo "--- net"; curl -sI -m 10 https://github.com | head -1 || echo "no github"
curl -sI -m 10 https://registry.ollama.ai/v2/ | head -1 || echo "no ollama registry"
curl -sI -m 10 https://huggingface.co | head -1 || echo "no hf"
echo "--- env"; cat /etc/os-release | head -2; ldd --version | head -1; df -h /tmp | tail -1

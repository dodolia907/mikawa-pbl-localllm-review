#!/bin/bash
#PBS -q iEduq
#PBS -N llmcompare
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -v SINGULARITY_IMAGE=/common/Singularity_sif/prg_env_intel_2025.02.sif
# 同じ PR を複数のモデルでレビューして比べる。
# 使い方(窓口サーバ。RUN_DIR は submit_review.sh が作ったディレクトリ):
#   qsub -o <ログ> -v "RUN_DIR=<dir>,ROOT=$PWD,MODELS=qwen3.8:27b-q8_0 flint:40b" jobs/compare.pbs
set -euo pipefail
ulimit -c 0

# PBS の -o はジョブ終了時にしか書き出されないので、進み具合を見るためのログを別に書く
exec > >(tee -a "$RUN_DIR/compare-live.log") 2>&1

read -r -a LIST <<< "$MODELS"
MODEL=${LIST[0]}
OLLAMA_LOG=$RUN_DIR/ollama-compare.log
. "$ROOT/jobs/ollama_env.sh"

for m in "${LIST[@]}"; do
  echo "=== $m"
  pull_model "$m" || continue
  load_on_gpu "$m" || exit 1      # GPU が使えないなら後のモデルも同じなので打ち切る
  out="$RUN_DIR/review-${m//[:\/]/_}.md"
  python3 "$ROOT/review.py" --host "$OLLAMA_URL" --model "$m" \
    --pr-json "$RUN_DIR/pr.json" --diff "$RUN_DIR/pr.diff" --out "$out" || echo "失敗: $m"
  # 次のモデルのために GPU メモリを空ける
  curl -s "$OLLAMA_URL/api/generate" -d "{\"model\":\"$m\",\"keep_alive\":0}" > /dev/null || true
done

#!/bin/bash
# ローカル LLM で GitHub の PR をレビューする CLI。窓口サーバ(ydev)で実行する。
# PR の情報と差分を gh で取得し、GPU ノードにジョブを投入し、終わるのを待ってレビューを表示する。
# 画面に出す文言は英語(レビュー本文の言語は review.py のプロンプトで決まる)。
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: review-pr [options] <owner/repo> <PR number>
       review-pr [options] <PR URL>
       review-pr [options] <owner/repo>  (choose the PR and settings interactively)
       review-pr                       (no arguments: interactive mode)

Options:
  -i, --interactive    Choose settings interactively (given arguments become defaults)
  -q, --queue QUEUE    Queue: iEduq (NVIDIA A100, default) or Eduq (AMD MI210)
  -g, --gpus N         Number of GPUs (iEduq: 1, Eduq: 1-2; default 1)
  -H, --host NODE      Pin the job to a node (e.g. yind01)
  -m, --model MODEL    Ollama model (default flint:40b)
  -o, --output FILE    Also save the review to FILE
      --mcp            Let the model read the repository (after the PR) through MCP tools,
                       plus the servers in mcp.json next to review-pr if it exists
      --scope DIR      With --mcp, only let the tools read DIR of the repository
                       (e.g. teams/invtechno; comma-separate several directories)
      --post           Post the review as a PR comment (asks for confirmation first)
      --no-wait        Submit the job and exit without waiting
      --quiet          Do not stream the model's output; show progress only
      --no-cache       Review every part again, even if an unchanged part was reviewed before
      --no-comments    Do not pass the PR's earlier comments and reviews to the model
      --context        Put the code of the PR's base at the start of the prompt (the --scope directory,
                       or the directory the PR touches); cached per commit, so reviews of the same repo reuse it
      --think-lines N  Show the model's thinking in a fixed box of N lines above the status line
                       (default 5; 0 hides it). The review itself still scrolls normally
      --new-job        Always submit a new job, even if a review server is running
      --server         Require a running review server (see review-server)
      --start-server   Start a review server (up to 8h) if none is running, then send the review to it
  -h, --help           Show this help

Examples:
  review-pr TechnoTUT/dmxctl 3
  review-pr https://github.com/TechnoTUT/dmxctl/pull/3
  review-pr -q Eduq -m qwen3.8:27b-q8_0 TechnoTUT/dmxctl 3

If a review server is running (review-server start), reviews are sent to it instead of
submitting a new job, so the model does not have to be loaded each time.
--start-server starts one first when none is running (on -q's queue if given).
EOF
}

die() { echo "review-pr: $*" >&2; exit 1; }

ROOT=$(cd "$(dirname "$(realpath "$0")")" && pwd)
MODEL=flint:40b
OUTPUT= POST=0 MCP=0 SCOPE= WAIT=1 THINK_ROWS=5 NO_CACHE=0 NO_COMMENTS=0 CONTEXT=0 INTERACTIVE=0 QUIET=0 NEW_JOB=0 REQUIRE_SERVER=0 START_SERVER=0 SERVER_DIR=
REPO= PR=
ARGS=()
while (( $# )); do
  case $1 in
    -i|--interactive) INTERACTIVE=1; shift ;;
    -q|--queue)  QUEUE=${2:?}; shift 2 ;;
    -g|--gpus)   NGPUS=${2:?}; shift 2 ;;
    -H|--host)   HOST=${2:?}; shift 2 ;;
    -m|--model)  MODEL=${2:?}; shift 2 ;;
    -o|--output) OUTPUT=${2:?}; shift 2 ;;
    --post)      POST=1; shift ;;
    --mcp)       MCP=1; shift ;;
    --scope)     SCOPE=${2:?}; MCP=1; shift 2 ;;
    --no-wait)   WAIT=0; shift ;;
    --quiet)     QUIET=1; shift ;;
    --no-cache)  NO_CACHE=1; shift ;;
    --no-comments) NO_COMMENTS=1; shift ;;
    --context)   CONTEXT=1; shift ;;
    --think-lines) THINK_ROWS=${2:?}; [[ $THINK_ROWS =~ ^[0-9]+$ ]] || die "--think-lines needs a number"; shift 2 ;;
    --new-job)   NEW_JOB=1; shift ;;
    --server)    REQUIRE_SERVER=1; shift ;;
    --start-server) START_SERVER=1; shift ;;
    -h|--help)   usage; exit 0 ;;
    -*)          usage >&2; die "unknown option: $1" ;;
    *)           ARGS+=("$1"); shift ;;
  esac
done

if (( ${#ARGS[@]} == 1 )) && [[ ${ARGS[0]} =~ github\.com/([^/]+/[^/]+)/pull/([0-9]+) ]]; then
  REPO=${BASH_REMATCH[1]} PR=${BASH_REMATCH[2]}
elif (( ${#ARGS[@]} == 2 )) && [[ ${ARGS[0]} == */* && ${ARGS[1]} =~ ^[0-9]+$ ]]; then
  REPO=${ARGS[0]} PR=${ARGS[1]}
elif (( ${#ARGS[@]} == 1 )) && [[ ${ARGS[0]} == */* ]] && { (( INTERACTIVE )) || [ -t 0 ]; }; then
  REPO=${ARGS[0]}                     # リポジトリだけ指定されたら、PR などは対話で選ぶ
  INTERACTIVE=1
elif (( ${#ARGS[@]} == 0 )) && [ -t 0 ]; then
  INTERACTIVE=1                       # 引数なしで端末から実行されたら対話モード
else
  usage >&2; exit 1
fi
command -v gh > /dev/null || die "gh not found"
(( NEW_JOB && REQUIRE_SERVER )) && die "--new-job and --server cannot be used together"
(( NEW_JOB && START_SERVER )) && die "--new-job and --start-server cannot be used together"
. "$ROOT/jobs/server_common.sh"
USER_QUEUE=${QUEUE:-}                 # -q で明示されたキュー(サーバを選ぶときに合わせる)

. "$ROOT/jobs/ui.sh"                  # 色の設定と、対話用の入力(ask)・メニュー(menu)

# 起動時のバナー(リポジトリ直下の motd)。ログに残さないよう、端末に出すときだけ表示する
if [ -t 2 ] && [ -f "$ROOT/motd" ]; then
  # 最初の空行まで(アスキーアート)はシアン、その下の説明は通常の色
  awk -v c="$CYAN" -v r="$RESET" '!art && /^$/ { art = 1 } { print (art ? $0 : c $0 r) } END { print "" }' \
    "$ROOT/motd" >&2
fi

# ---- 対話モード ----------------------------------------------------------
interactive() {
  local -a opts=()
  local m sel
  # Ctrl-C で抜けても、隠したカーソルと止めた折り返しを戻す
  trap 'printf "\e[?25h\e[?7h" > /dev/tty 2> /dev/null' EXIT
  echo "== review-pr: interactive mode (Ctrl-C to cancel)" >&2

  until [[ $REPO =~ ^[^/[:space:]]+/[^/[:space:]]+$ ]]; do
    [ -n "$REPO" ] && echo "  Enter it as owner/repo" >&2
    ask REPO "Repository (owner/repo)"
  done

  if [ -z "$PR" ]; then
    mapfile -t opts < <(gh pr list -R "$REPO" --state open --limit 30 \
      --json number,title,author,isDraft,additions,deletions \
      --jq '.[] | "\(.number)\t#\(.number)  \(.title)  (\(.author.login), +\(.additions)/-\(.deletions)\(if .isDraft then ", draft" else "" end))"') \
      || die "cannot access repository: $REPO"
    if (( ${#opts[@]} )); then
      menu PR "Pull request" "" "${opts[@]}" $'other\tOther (enter a number; merged PRs work too)'
    else
      echo "No open pull requests (you can still enter the number of a merged one)" >&2
      PR=other
    fi
    if [ "$PR" = other ]; then
      PR=
      until [[ $PR =~ ^[0-9]+$ ]]; do ask PR "PR number"; done
    fi
  fi

  local -a srv=() start=() d def="${QUEUE:-iEduq}:${NGPUS:-1}" busy=" "
  local -a places=(
    $'iEduq:1\tiEduq  NVIDIA A100 80GB x1 (yind00/01)'
    $'Eduq:1\tEduq   AMD MI210 64GB x1 (ysnd00/01)'
    $'Eduq:2\tEduq   AMD MI210 64GB x2 (ysnd00/01; for models over 64GB, no speedup for models that fit on one)'
  )
  for d in $(list_servers); do
    server_alive "$d" || continue
    busy+="$(cat "$d/queue_name") "
    (( NEW_JOB )) || srv+=("server:$d"$'\t'"Running server: $(server_desc "$d") (no model loading)")
  done
  (( ${#srv[@]} )) && def=${srv[0]%%$'\t'*}
  (( START_SERVER )) && def=start
  # サーバは 1 キューに 1 つまで(同時実行は 1 人 1 ジョブ)。サーバのないキューがあれば起動の選択肢を出す
  for d in "${places[@]}"; do [[ $busy == *" ${d%%:*} "* ]] || start+=("$d"); done
  (( !NEW_JOB && ${#start[@]} )) && srv+=($'start\tStart a review server (up to 8h)')
  menu sel "Where to run" "$def" "${srv[@]}" "${places[@]/$'\t'/$'\t'New job: }"
  if [[ $sel == server:* ]]; then
    SERVER_DIR=${sel#server:}; QUEUE=$(cat "$SERVER_DIR/queue_name"); NGPUS=
  elif [ "$sel" = start ]; then
    menu sel "Server queue / GPU" "${QUEUE:-iEduq}:${NGPUS:-1}" "${start[@]}"
    QUEUE=${sel%:*} NGPUS=${sel#*:} START_SERVER=1 USER_QUEUE=${sel%:*}
  else
    QUEUE=${sel%:*} NGPUS=${sel#*:} START_SERVER=0; (( ${#srv[@]} )) && NEW_JOB=1
  fi

  # 取得済みのモデル(/work/$USER/llm/models の目録)を選択肢にする
  opts=()
  while IFS= read -r m; do
    m=${m#*/manifests/*/}; m=${m#library/}; m="${m%/*}:${m##*/}"
    opts+=("$m"$'\t'"$m")
  done < <(find "${LLM_HOME:-/work/$USER/llm}/models/manifests" -mindepth 3 -type f 2>/dev/null | sort)
  if ! printf '%s\n' "${opts[@]}" | grep -qxF "$MODEL"$'\t'"$MODEL"; then
    opts=("$MODEL"$'\t'"$MODEL (not downloaded yet; fetched on first use)" "${opts[@]}")
  fi
  menu MODEL "Model" "$MODEL" "${opts[@]}" $'other\tOther (enter a model name; fetched on first use)'
  if [ "$MODEL" = other ]; then
    MODEL=
    until [ -n "$MODEL" ]; do ask MODEL "Model name (e.g. qwen3.8:27b-q8_0)"; done
  fi

  if [ -z "$SERVER_DIR" ]; then
    if [ "$QUEUE" = Eduq ]; then opts=(ysnd00 ysnd01); else opts=(yind00 yind01); fi
    menu HOST "Node" "${HOST:-}" $'\tAny (whichever is free)' "${opts[0]}"$'\t'"${opts[0]}" "${opts[1]}"$'\t'"${opts[1]}"
  fi

  menu MCP "Tools (MCP)" "$MCP" $'0\tDiff only' \
    $'1\tLet the model read the repository after the PR through MCP tools (slower, more context)'
  menu POST "Post to PR" "$POST" $'0\tDo not post' $'1\tPost as a PR comment (shows the review and asks first)'
  if (( POST )); then
    WAIT=1
  else
    menu WAIT "Wait" "$WAIT" $'1\tWait and show the review' $'0\tSubmit and exit (read the result file later)'
  fi

  # 同じ内容を引数で指定するコマンド(次回からそのまま使える)
  local cmd="review-pr"
  if [ -n "$SERVER_DIR" ]; then
    cmd+=" --server"
    [ "$QUEUE" != iEduq ] && cmd+=" -q $QUEUE"
  else
    (( NEW_JOB )) && cmd+=" --new-job"
    # --start-server は -q がないと、ほかのキューで動いているサーバにも依頼するので、キューを必ず書く
    if (( START_SERVER )); then cmd+=" --start-server -q $QUEUE"
    elif [ "$QUEUE" != iEduq ]; then cmd+=" -q $QUEUE"; fi
    [ "${NGPUS:-1}" != 1 ] && cmd+=" -g $NGPUS"
    [ -n "${HOST:-}" ] && cmd+=" -H $HOST"
  fi
  [ "$MODEL" != flint:40b ] && cmd+=" -m $MODEL"
  [ -n "$OUTPUT" ] && cmd+=" -o $OUTPUT"
  (( MCP )) && cmd+=" --mcp"
  [ -n "$SCOPE" ] && cmd+=" --scope $SCOPE"
  (( POST )) && cmd+=" --post"
  (( WAIT )) || cmd+=" --no-wait"
  [ "$THINK_ROWS" != 5 ] && cmd+=" --think-lines $THINK_ROWS"
  (( NO_CACHE )) && cmd+=" --no-cache"
  (( NO_COMMENTS )) && cmd+=" --no-comments"
  (( CONTEXT )) && cmd+=" --context"
  cmd+=" $REPO $PR"
  echo >&2; echo "Equivalent command: $cmd" >&2
  menu sel "Run it?" yes $'yes\tRun' $'no\tCancel'
  [ "$sel" = yes ] || { echo "Cancelled." >&2; exit 0; }
}
(( INTERACTIVE )) && interactive

(( POST && !WAIT )) && die "--post and --no-wait cannot be used together"
. "$ROOT/jobs/qsub_common.sh"

RUN="$ROOT/runs/${REPO//\//_}/pr${PR}-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$RUN"
gh pr view "$PR" -R "$REPO" --json number,title,body,author,baseRefName,baseRefOid,headRefName,headRefOid,files,additions,deletions \
  > "$RUN/pr.json" || { rm -rf "$RUN"; die "cannot fetch pull request $REPO#$PR"; }
gh pr diff "$PR" -R "$REPO" > "$RUN/pr.diff"
(( NO_CACHE )) && touch "$RUN/no-cache"     # ジョブ(jobs/run_review.sh)はこれを見て、キャッシュを使わない
# これまでのコメントとレビュー(レビューし直すとき、対応済みや誤りと確認された指摘を繰り返さないため)
if (( !NO_COMMENTS )); then
  gh pr view "$PR" -R "$REPO" --json comments,reviews > "$RUN/pr-comments.json" 2>/dev/null \
    || rm -f "$RUN/pr-comments.json"
fi
TITLE=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["title"])' "$RUN/pr.json")
echo "${BOLD}$REPO#$PR${RESET} $TITLE ${DIM}($(wc -l < "$RUN/pr.diff") diff lines)${RESET}" >&2
# 大きな PR はファイルごとのパートに分けてレビューする(分け方は review.py と同じ関数で数える)
NPARTS=$(cd "$ROOT" && python3 -I -c 'import sys; sys.path.insert(0, "."); import review
print(len(review.make_parts(open(sys.argv[1], encoding="utf-8", errors="replace").read())))' "$RUN/pr.diff")
(( NPARTS > 1 )) && echo "${DIM}Large diff: reviewing in $NPARTS parts, then merging the results${RESET}" >&2

# --mcp: PR 適用後のソースを窓口サーバで取得し(gh のトークンは計算ノードに渡さない)、
# モデルがツールで読めるよう、MCP サーバの設定(mcp.json)を実行ディレクトリに置く
# --context: PR のベース(base)の時点のソースを、プロンプトの先頭に載せる。ソースはコミットごとに
# cache/src/ に取っておき、同じコミットなら取得し直さない(gh のトークンは計算ノードに渡さない)
if (( CONTEXT )); then
  BASE_SHA=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["baseRefOid"])' "$RUN/pr.json")
  CTX="$ROOT/cache/src/${REPO//\//_}/$BASE_SHA"
  if [ ! -d "$CTX" ]; then
    mkdir -p "$CTX.tmp.$$"
    gh api "repos/$REPO/tarball/$BASE_SHA" | tar -xz -C "$CTX.tmp.$$" --strip-components=1 \
      && mv "$CTX.tmp.$$" "$CTX" \
      || { rm -rf "$CTX.tmp.$$" "$RUN"; die "cannot download the base source of $REPO@${BASE_SHA:0:7}"; }
  fi
  # ジョブ(jobs/run_review.sh)に渡す: ソースの場所、範囲(--scope。空なら変更されたファイルから決める)、名前
  printf '%s\n%s\n%s\n' "$CTX" "$SCOPE" "$REPO@${BASE_SHA:0:7}" > "$RUN/context"
  echo "${DIM}Code context: $REPO@${BASE_SHA:0:7} (base)${SCOPE:+, $SCOPE}${RESET}" >&2
fi

if (( MCP )); then
  . "$ROOT/jobs/run_review.sh"
  [ -x "$UV" ] || { rm -rf "$RUN"; die "--mcp needs uv ($UV)"; }
  SHA=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["headRefOid"])' "$RUN/pr.json")
  mkdir -p "$RUN/src"
  gh api "repos/$REPO/tarball/$SHA" | tar -xz -C "$RUN/src" --strip-components=1 \
    || { rm -rf "$RUN"; die "cannot download the source of $REPO@${SHA:0:7}"; }
  echo "${DIM}Source for MCP tools: $REPO@${SHA:0:7} ($(du -sh "$RUN/src" | cut -f1))${RESET}" >&2
  mcp_prepare || { rm -rf "$RUN"; die "cannot prepare the MCP environment (uv, $MCP_SDK)"; }
  # 組み込みのサーバ(repo: ファイルを読む、check: 静的な検査、docs: 資料)に、
  # リポジトリ直下の mcp.json(あれば)のサーバを加える
  python3 - "$ROOT/mcp.json" "$RUN/mcp.json" "$RUN/src" "${LLM_HOME:-/work/$USER/llm}/docs" "$SCOPE" <<'PY' \
    || { rm -rf "$RUN"; die "cannot write the MCP settings"; }
import glob, json, os, re, sys
user_cfg, out, src, docs, scope = sys.argv[1:6]
# --scope: ツールが読めるフォルダ(リポジトリ直下からの相対パス)。サーバの側で範囲の外を拒否する
scopes = [s.strip().strip("/") for s in scope.split(",") if s.strip()]
for s in scopes:
    if not os.path.isdir(os.path.join(src, s)):
        sys.exit(f"--scope: no such directory in the repository: {s}")
scope_args = ["--scope", ",".join(scopes)] if scopes else []
servers = {
    "repo": {"command": "${PYTHON}", "args": ["${ROOT}/mcp_repo_server.py", "${RUN_DIR}/src", *scope_args]},
    "check": {"command": "${PYTHON}", "args": ["${ROOT}/mcp_check_server.py", "${RUN_DIR}/src", *scope_args]},
}

def read(*names):
    text = ""
    for n in names:
        for p in glob.glob(os.path.join(src, n)):
            with open(p, encoding="utf-8", errors="replace") as f:
                text += f.read() + "\n"
    return text

def vkey(d):
    return [int(x) for x in re.findall(r"\d+", os.path.basename(d))]

def pick(kind, want):
    """取得済みの資料から、want(版の先頭部分)に合う最も新しい版を選ぶ。なければ最も新しい版。"""
    have = sorted(glob.glob(os.path.join(docs, kind + "-*")), key=vkey)
    match = [d for d in have if want and (os.path.basename(d) + ".").startswith(f"{kind}-{want}.")]
    return (match or have or [None])[-1]

deps = read("pyproject.toml", "requirements*.txt", "setup.cfg")
py = re.search(r'requires-python\s*=\s*"[^"]*?(\d+\.\d+)', deps)
dj = re.search(r'(?im)^\W*django\s*[=~<>!]=*\s*(\d+(?:\.\d+)*)', deps)
uses_django = bool(re.search(r"(?i)\bdjango\b", deps)) or os.path.exists(os.path.join(src, "manage.py"))
dirs = [pick("python", py and py.group(1))]
if uses_django:
    dirs.append(pick("django", dj and dj.group(1)))
dirs.append(os.path.join(docs, "mdn-html") if os.path.isdir(os.path.join(docs, "mdn-html")) else None)
dirs = [d for d in dirs if d]
if dirs:
    servers["docs"] = {"command": "${PYTHON}", "args": ["${ROOT}/mcp_docs_server.py", *dirs]}
if os.path.exists(user_cfg):
    with open(user_cfg) as f:
        servers.update(json.load(f).get("mcpServers", {}))
with open(out, "w") as f:
    # scope は review.py がプロンプトで範囲を伝えるのに使う(MCP の設定としては使われない)
    json.dump({"mcpServers": servers, "scope": scopes}, f, indent=2)
docs_note = (" (docs: " + ", ".join(os.path.basename(d) for d in dirs) + ")") if dirs \
    else " (no docs; run fetch-docs to add them)"
print("MCP servers: " + ", ".join(servers) + docs_note
      + (f"; tools read only {', '.join(s + '/' for s in scopes)}" if scopes else ""), file=sys.stderr)
PY
fi
# ジョブの時間上限: 30 分 + パートごとに 15 分(Eduq は遅いので 2 倍)。最長 8 時間
[ "$QUEUE" = Eduq ] && WALL_MIN=$(( 30 + NPARTS * 30 )) || WALL_MIN=$(( 30 + NPARTS * 15 ))
(( NPARTS > 1 )) && WALL_MIN=$(( WALL_MIN + 15 ))   # まとめの分
(( MCP )) && WALL_MIN=$(( WALL_MIN + NPARTS * 15 ))  # ツールを使う分
(( WALL_MIN > 480 )) && WALL_MIN=480
printf -v WALL '%02d:%02d:00' $(( WALL_MIN / 60 )) $(( WALL_MIN % 60 ))

# 動いているレビューサーバを探す(-q や -H を指定していれば、それに合うもの)
if (( !NEW_JOB )) && [ -z "$SERVER_DIR" ]; then
  for d in $(list_servers); do
    server_alive "$d" || continue
    [ -n "$USER_QUEUE" ] && [ "$(cat "$d/queue_name")" != "$USER_QUEUE" ] && continue
    if [ -n "${HOST:-}" ]; then
      read -r h _ < "$d/info" 2>/dev/null || h=
      [ "$h" != "$HOST" ] && continue
    fi
    SERVER_DIR=$d; break
  done
fi
# --start-server: 合うサーバがなければ起動し、モデルを読み込み終わるまで待つ
if (( START_SERVER )) && [ -z "$SERVER_DIR" ]; then
  echo "${DIM}No review server is running on $QUEUE; starting one (up to 8h)${RESET}" >&2
  # 待っている間の Ctrl-C は review-server にも届く。サーバは起動を続けるので、この依頼だけやめる
  trap 'echo "Stopped; the server keeps starting (check with: review-server status). Run review-pr again to use it." >&2; rm -rf "$RUN"; exit 130' INT
  "$ROOT/review-server" start -q "$QUEUE" -g "$NGPUS" ${HOST:+-H "$HOST"} -m "$MODEL" \
    || { rm -rf "$RUN"; die "could not start a review server"; }
  trap - INT
  for d in $(list_servers); do
    if server_alive "$d" && [ "$(cat "$d/queue_name")" = "$QUEUE" ]; then SERVER_DIR=$d; break; fi
  done
  [ -n "$SERVER_DIR" ] || { rm -rf "$RUN"; die "the review server started but cannot be found"; }
fi
(( REQUIRE_SERVER )) && [ -z "$SERVER_DIR" ] && die "no review server is running${USER_QUEUE:+ on $USER_QUEUE}; start one with: review-server start"

submit_job() {
  JOB=$(qsub -o "$RUN/job.log" "${QSUB_ARGS[@]}" -l "walltime=$WALL" \
    -v "$QSUB_VARS,RUN_DIR=$RUN,MODEL=$MODEL,ROOT=$ROOT" "$ROOT/jobs/review.pbs")
  MODE=job STATE=Q
  echo "$JOB" > "$RUN/job"                  # --no-wait の後でも状態を調べられるよう残す(review-mcp が使う)
  echo "${DIM}Job ${JOB%%.*} on $QUEUE (${NGPUS} GPU, up to $WALL), model $MODEL${RESET}" >&2
}

REQ=
if [ -n "$SERVER_DIR" ]; then
  # サーバの queue/ に依頼を置く(書きかけを読まれないよう、別名で書いてから mv する)
  MODE=server STATE=Q JOB=
  REQ=$(date +%s%N)-$$
  echo queued > "$RUN/status"
  # サーバでの所要時間の見込み(モデルの読み込みがない分、ジョブより短い): パートごとに 10 分 + まとめ 10 分、Eduq は 2 倍
  EST_MIN=$(( NPARTS * (MCP ? 20 : 10) + (NPARTS > 1 ? 10 : 0) ))
  [ "$QUEUE" = Eduq ] && EST_MIN=$(( EST_MIN * 2 ))
  echo "$RUN $MODEL $EST_MIN" > "$SERVER_DIR/.$REQ"
  mv "$SERVER_DIR/.$REQ" "$SERVER_DIR/queue/$REQ"
  echo "${DIM}Sent to review server $(basename "$SERVER_DIR") ($(server_desc "$SERVER_DIR")), model $MODEL${RESET}" >&2
else
  submit_job
fi
echo "${DIM}Output: $RUN${RESET}" >&2
if (( !WAIT )); then
  if [ "$MODE" = server ]; then echo "Result will be written to $RUN/review.md (status: $RUN/status)" >&2
  else echo "Result will be written to $RUN/review.md (check with: qstat $JOB)" >&2; fi
  exit 0
fi

# ---- ジョブの待機と、生成途中の出力の表示 ------------------------------------
# ジョブは stream.txt に生成途中の出力を書き足し、stream.txt.stat に段階とトークン数を書く。
# /work は計算ノードと共有なので、窓口サーバからこれを読んで表示できる。
# 端末では、確定した行(本文・ツール・見出し)を上に流し、一番下に Claude Code 風の状態表示の行を出す。
# 考える過程は流さず、状態表示の行のすぐ上の固定の枠(THINK_ROWS 行)の中で、最新の行だけを入れ替えて見せる。
STREAM=$RUN/stream.txt
TTY=0; [ -t 2 ] && TTY=1
VERBS=(Simmering Pondering Brewing Percolating Cogitating Mulling Ruminating Noodling
       Deliberating Marinating Contemplating Musing Churning Stewing Puzzling Scheming)
FRAME=0.1                                     # 状態表示を描き直す間隔(秒)
SHINE=; [ -n "$BOLD" ] && SHINE=$'\e[1;96m'   # 動詞の上を流れる明るい帯の色(明るいシアン)
VERB=${VERBS[RANDOM % ${#VERBS[@]}]}
OFF=0 PARTIAL= SECTION= PHASE="queued" LASTPHASE= TOKENS=0 TICK=0
THINK_BUF=() LIVE_H=0                         # 枠に出す考える過程の行 / 今描いている枠の高さ(状態表示の行を除く)
COLS=80
if (( TTY )); then
  COLS=$(tput cols 2>/dev/null || echo 80)
  trap 'COLS=$(tput cols 2>/dev/null || echo 80)' WINCH   # 端末の幅が変わったら測り直す
fi
printf -v START '%(%s)T' -1
STATE=Q QSTAT_PID= QSTAT_AT=0 QSTATE_FILE=$RUN/.qstate
# sleep コマンドを起動せずに待つため、何も書かれないパイプを read -t で待つ
exec {SLEEP_FD}<> <(:)

# 描き直しのたびに外部コマンドを起動しないよう、時刻や整形は bash の組み込み機能だけで行う
# fmt_time <変数名> <秒>、fmt_tokens <変数名> <数>
fmt_time() { if (( $2 >= 60 )); then printf -v "$1" '%dm %ds' $(($2 / 60)) $(($2 % 60)); else printf -v "$1" '%ds' "$2"; fi; }
fmt_tokens() { if (( $2 >= 1000 )); then printf -v "$1" '%d.%dk' $(($2 / 1000)) $(($2 % 1000 / 100)); else printf -v "$1" '%d' "$2"; fi; }

# tail_fit <変数名> <文字列> <幅>: 文字列の末尾を、画面で <幅> 桁に収まる分だけ残す(切ったら先頭に …)。
# 日本語などの全角文字は 2 桁と数える。毎コマ呼ぶので、明らかに収まる行はそのまま返す
tail_fit() {
  local s=$2 max=$3 i c cw=0 code n=${#2}
  if (( n * 2 <= max )); then printf -v "$1" '%s' "$s"; return 0; fi
  for (( i = n - 1; i >= 0; i-- )); do
    c=${s:i:1}
    printf -v code '%d' "'$c"
    if (( code >= 0x1100 )); then cw=$(( cw + 2 )); else cw=$(( cw + 1 )); fi
    if (( cw > max - 1 )); then printf -v "$1" '…%s' "${s:i+1}"; return 0; fi
  done
  printf -v "$1" '%s' "$s"
}

# 状態表示の行と、その上の考える過程の枠を消す(端末のときだけ)。カーソルは枠のあった一番上に戻る
clear_status() {
  (( TTY )) || return 0
  local s=$'\r\e[K' i
  for (( i = 0; i < LIVE_H; i++ )); do s+=$'\e[1A\e[K'; done
  printf '%s' "$s" >&2
  LIVE_H=0
}

# 確定した行を 1 行出す(枠と状態表示の行を消してから。次のコマで描き直される)
out() { clear_status; printf '%s\n' "$1" >&2; }

# 考える過程を枠に入れるか(端末で、枠を出すとき)
think_in_box() { (( TTY )) && [ "$SECTION" = thinking ]; }

# 確定した行を表示する。=== 見出し === で、考える過程(薄い色)か本文かを切り替える。
emit_lines() {
  local line
  while IFS= read -r line; do
    case $line in
      "=== Thinking ===")  SECTION=thinking; THINK_BUF=()
                           (( TTY )) || out "${DIM}${CYAN}── thinking ──${RESET}" ;;
      "=== Review ===")    SECTION=review; THINK_BUF=(); out "${CYAN}── review ──${RESET}" ;;
      "=== "*" ===")       line=${line#=== }; out "${DIM}${line% ===}${RESET}" ;;
      *) if think_in_box; then
           # 空行は飛ばし、最新の THINK_ROWS 行だけを残す
           # set -e の下なので、条件が偽でも失敗にならないよう if で書く
           if [ -n "${line// /}" ]; then THINK_BUF+=("$line"); fi
           if (( ${#THINK_BUF[@]} > THINK_ROWS )); then THINK_BUF=("${THINK_BUF[@]: -THINK_ROWS}"); fi
         elif [ "$SECTION" = thinking ]; then out "${DIM}${line}${RESET}"
         else out "$line"; fi ;;
    esac
  done <<< "$1"
}

# stream.txt の新しく増えた分を読み、改行で終わる行だけを表示する(途中の行は状態表示の行に出す)
pump_stream() {
  (( QUIET )) && return 0
  [ -f "$STREAM" ] || return 0
  local size data
  size=$(stat -c %s "$STREAM" 2>/dev/null || echo 0)
  (( size > OFF )) || return 0
  data=$(tail -c +$((OFF + 1)) "$STREAM" | head -c $((size - OFF)); printf x)
  data=${data%x}
  OFF=$size
  data=$PARTIAL$data
  if [[ $data == *$'\n'* ]]; then
    emit_lines "${data%$'\n'*}"
    PARTIAL=${data##*$'\n'}
  else
    PARTIAL=$data
  fi
}

# サーバに依頼したときの状態: 依頼の status ファイルを読む(5 秒ごとに、サーバが生きているかも見る)
AHEAD= SRV_CHECK_AT=0
poll_server() {
  local st reason now f n
  read -r st reason < "$RUN/status" 2>/dev/null || st=queued
  case $st in
    queued)
      STATE=Q
      # 自分より前に並んでいる依頼の数(取り出し済みの実行中の分も足す)
      n=0
      for f in "$SERVER_DIR"/queue/*; do [ -e "$f" ] || continue; [[ ${f##*/} < $REQ ]] && n=$(( n + 1 )); done
      n=$(( n + $(ls -1 "$SERVER_DIR/running" 2>/dev/null | wc -l) ))
      AHEAD=$n ;;
    running) STATE=R ;;
    done|failed) STATE= ;;
    rejected)
      clear_status
      echo "${RED}The review server declined the request:${RESET} $reason; submitting a new job instead" >&2
      rm -f "$RUN/status"
      submit_job
      return ;;
  esac
  printf -v now '%(%s)T' -1
  if [ -n "$STATE" ] && (( now - SRV_CHECK_AT >= 5 )); then
    SRV_CHECK_AT=$now
    if ! server_alive "$SERVER_DIR"; then
      finish_status
      die "the review server stopped responding; run again (it will submit a new job if no server is running)"
    fi
  fi
}

poll_state() { if [ "$MODE" = server ]; then poll_server; else poll_qstat; fi; }

# 中断したとき: ジョブなら取り消し、サーバへの依頼なら並んでいれば消し、実行中なら止めてもらう
cancel_run() {
  if [ "$MODE" = server ]; then
    if rm "$SERVER_DIR/queue/$REQ" 2>/dev/null; then echo "Interrupted; removed the request from the server queue" >&2
    else touch "$RUN/cancel"; echo "Interrupted; asked the server to stop this review" >&2; fi
  else
    echo "Interrupted; cancelling job ${JOB%%.*}" >&2; qdel "$JOB" 2>/dev/null || true
  fi
}

# ジョブの状態を確認する。qstat は 0.2 秒ほどかかって描き直しが止まるので、
# バックグラウンドで実行して結果をファイルで受け取る(5 秒ごと)
poll_qstat() {
  local now
  if [ -n "$QSTAT_PID" ]; then
    kill -0 "$QSTAT_PID" 2>/dev/null && return 0          # まだ実行中
    wait "$QSTAT_PID" 2>/dev/null || true
    QSTAT_PID=
    STATE=
    [ -f "$QSTATE_FILE" ] && read -r STATE < "$QSTATE_FILE" || true
  fi
  printf -v now '%(%s)T' -1
  if (( now - QSTAT_AT >= 5 )); then
    QSTAT_AT=$now
    # ジョブが終わると qstat は失敗する。set -e と pipefail を引き継いだサブシェルがそこで止まらないよう、
    # 失敗しても必ず(空の)結果を書く。空なら、ジョブは終わっている
    { qstat -f "$JOB" 2>/dev/null | awk '/job_state =/ {print $3}' > "$QSTATE_FILE.tmp" || true
      mv -f "$QSTATE_FILE.tmp" "$QSTATE_FILE"; } &
    QSTAT_PID=$!
  fi
}

# 段階(phase)を決める: キュー待ち → ジョブ側の進み具合 → 生成の段階
update_phase() {
  local p n part total now el
  local -a pl
  case $STATE in
    Q) if [ "$MODE" = server ]; then PHASE="waiting for the server${AHEAD:+ ($AHEAD ahead)}"; else PHASE="queued"; fi ;;
    E) PHASE="finishing" ;;
    R) PHASE="starting"
       if [ -s "$RUN/progress" ]; then mapfile -t pl < "$RUN/progress"; PHASE=${pl[-1],,}; fi
       if [ -f "$STREAM.stat" ] && read -r p n part total < "$STREAM.stat" 2>/dev/null; then
         TOKENS=${n:-0}
         case $p in reading) PHASE="reading diff" ;; thinking) PHASE="thinking" ;;
                    writing) PHASE="writing review" ;; tool) PHASE="using tools" ;; done) PHASE="done" ;; esac
         # パートに分けているときは、何番目のパートか(またはまとめ中か)を前に付ける
         case ${part:--} in
           -) ;;
           merge) [ "$p" = done ] || PHASE="merging parts · $PHASE" ;;
           *) PHASE="part $part/$total · $PHASE" ;;
         esac
       fi ;;
  esac
  if [ "$PHASE" != "$LASTPHASE" ]; then
    # 段階が変わったら言葉も変える。端末でないときは、段階の変化を 1 行ずつ記録する
    VERB=${VERBS[RANDOM % ${#VERBS[@]}]}
    if (( !TTY )); then
      printf -v now '%(%s)T' -1; fmt_time el $(( now - START ))
      echo "[$el] $PHASE" >&2
    fi
    LASTPHASE=$PHASE
  fi
}

# 一番下の状態表示の行: Simmering… (1m 12s · ↓ 3.4k tokens · thinking · ctrl+c to cancel)  途中の行…
draw_status() {
  (( TTY )) || return 0
  local now el tk info ptail verb
  printf -v now '%(%s)T' -1
  fmt_time el $(( now - START ))
  info=$el
  if (( TOKENS > 0 )); then fmt_tokens tk "$TOKENS"; info+=" · ↓ $tk tokens"; fi
  info+=" · $PHASE · ctrl+c to cancel"
  # 考える過程の枠: 見出しと THINK_ROWS 行。高さは固定(足りない分は空行)で、画面を流さない
  local box= rows=0 l w=$(( COLS - 4 )) i
  local -a lines=()
  if think_in_box && (( THINK_ROWS > 0 )); then
    lines=("${THINK_BUF[@]}")
    [ -n "${PARTIAL// /}" ] && lines+=("$PARTIAL")
    if (( ${#lines[@]} > THINK_ROWS )); then lines=("${lines[@]: -THINK_ROWS}"); fi
    box="${DIM}${CYAN}── thinking ──${RESET}"$'\e[K\n'; rows=1
    for (( i = 0; i < THINK_ROWS; i++ )); do
      l=${lines[i]:-}
      tail_fit l "$l" "$w"                               # 長い行は末尾(書いている所)を見せる
      box+="  ${DIM}${l}${RESET}"$'\e[K\n'; rows=$(( rows + 1 ))
    done
    ptail=
  else
    ptail=${PARTIAL: -60}
  fi
  # 前の枠の一番上に戻り、折り返しを止めて 1 回の書き込みで描く(長い行は画面の端で切れる)。
  # 枠が低くなったときに残る古い行は、最後の \e[J で消す
  local up=
  for (( i = 0; i < LIVE_H; i++ )); do up+=$'\e[1A'; done
  shimmer verb "$VERB"
  printf '\e[?7l\r%s%s%s…%s %s%s\e[K\e[J\e[?7h' "$up" "$box" "$verb" "$RESET" "${DIM}(${info})" \
    "${ptail:+  $ptail}${RESET}" >&2
  LIVE_H=$rows
  TICK=$(( TICK + 1 ))
}

# shimmer <変数名> <文字列>: 明るい帯(3 文字)が 1 コマに 1 文字ずつ左から右へ流れるように色を付ける。
# 帯が文字列の外にいる間(8 コマ)は何も光らず、間が空く
shimmer() {
  local n=${#2} p a b
  p=$(( TICK % (n + 8) - 3 ))                 # 帯の左端
  a=$(( p < 0 ? 0 : p )) b=$(( p + 3 > n ? n : p + 3 ))
  if [ -n "$SHINE" ] && (( a < b )); then
    printf -v "$1" '%s%s%s%s%s%s' "$BOLD" "${2:0:a}" "$SHINE" "${2:a:b-a}" "$RESET$BOLD" "${2:b}"
  else
    printf -v "$1" '%s%s' "$BOLD" "$2"
  fi
}

finish_status() { clear_status; (( TTY )) && printf '\e[?25h' >&2 || true; }

# 待っている間に Ctrl-C されたら、ジョブも取り消す
trap 'finish_status; echo; cancel_run; exit 130' INT TERM
(( TTY )) && printf '\e[?25l' >&2            # 状態表示の間はカーソルを隠す
poll_state
while :; do
  poll_state
  [ -z "$STATE" ] && break                   # qstat に出なくなったらジョブは終わっている
  if [ "$STATE" = H ]; then
    qdel "$JOB" 2>/dev/null; finish_status
    die "the job was held (H); the node may be unhealthy. Try another node with -H"
  fi
  # ファイルを読む処理は 3 コマに 1 回(0.3 秒ごと)。描き直しは毎コマ
  if (( TICK % 3 == 0 )); then update_phase; pump_stream; fi
  draw_status
  (( TTY )) || TICK=$(( TICK + 1 ))
  read -t "$FRAME" -u "$SLEEP_FD" _ || true
done
rm -f "$QSTATE_FILE"
pump_stream                                  # 最後に残った分を出す
[ -n "$PARTIAL" ] && { emit_lines "$PARTIAL"; PARTIAL=; }
finish_status
trap - INT TERM
STREAMED=0; (( !QUIET )) && [ -f "$STREAM" ] && STREAMED=1

# qstat から消えても、ジョブのログが書き出されるまで少し待つ
for _ in $(seq 30); do [ -f "$RUN/job.log" ] && break; sleep 2; done
if [ ! -s "$RUN/review.md" ]; then
  echo "${RED}Review failed.${RESET} Last lines of the job log:" >&2
  tail -15 "$RUN/job.log" >&2 2>/dev/null || true
  exit 1
fi

echo >&2
if (( STREAMED )) && [ -t 1 ]; then
  # 本文はもう画面に流れたので、繰り返さない(リダイレクトしているときは本文を出力する)
  echo "${DIM}Saved: $RUN/review.md${RESET}" >&2
else
  cat "$RUN/review.md"
fi
[ -n "$OUTPUT" ] && cp "$RUN/review.md" "$OUTPUT" && echo "Saved: $OUTPUT" >&2

if (( POST )); then
  read -r -p "Post this review as a comment on $REPO#$PR? [y/N] " ans < /dev/tty
  if [[ $ans == [yY]* ]]; then
    SHA=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["headRefOid"])' "$RUN/pr.json")
    { echo "> 🤖 ローカルLLM(\`$MODEL\`)による自動レビューです(コミット ${SHA:0:7})。誤りを含むことがあるので、参考情報として扱ってください。"
      echo; cat "$RUN/review.md"; } > "$RUN/comment.md"
    gh pr comment "$PR" -R "$REPO" --body-file "$RUN/comment.md"
  else
    echo "Not posted." >&2
  fi
fi
